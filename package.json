{
  "name": "sports-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "spike": "node spike/run.js",
    "build-data": "node --env-file-if-exists=.env scripts/build-data.js && node scripts/build-standings.js && node scripts/build-mlb.js && node scripts/build-fights.js",
    "build-mlb": "node --env-file-if-exists=.env scripts/build-mlb.js",
    "build-fights": "node scripts/build-fights.js",
    "test-fights": "node spike/test-fight-correlation.js",
    "test-mlb": "node spike/test-mlb.js",
    "test-football": "node spike/test-football-correlation.js",
    "test-euro-broadcast": "node spike/test-euro-broadcast.js",
    "test-footyontv": "node spike/test-footyontv.js",
    "serve": "node scripts/serve.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.7.7",
    "cheerio": "^1.0.0"
  }
}
